# Creative Matrimony Backend — copy to .env and fill in

# Database
# Local dev (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Production (Neon PostgreSQL) — paste the connection string as-is;
# the app normalizes postgres:///sslmode automatically:
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Auth
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookies — set COOKIE_SAMESITE=none when the frontend is on a different domain
COOKIE_SAMESITE=lax
COOKIE_SECURE=true

# OTP (mock provider prints the OTP to the server console)
OTP_PROVIDER=mock

# Email (Resend) — empty key disables outbound email
RESEND_API_KEY=
# EMAIL_FROM="Creative Matrimony <noreply@yourdomain.com>"  # after domain verification in Resend

# CORS — JSON list of allowed frontend origins
CORS_ORIGINS=["http://localhost:3000"]

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./uploads

# Debug
DEBUG=true
