# Creative Matrimony Backend — copy to .env and fill in

# Database
# Local dev (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Production (Neon PostgreSQL) — paste the connection string as-is;
# the app normalizes postgres:///sslmode automatically:
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Auth
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookies — set COOKIE_SAMESITE=none when the frontend is on a different domain
COOKIE_SAMESITE=lax
COOKIE_SECURE=true

# OTP delivery: "mock" (prints to console) | "fast2sms" (Indian SMS) | "whatsapp"
OTP_PROVIDER=mock
# Dev/staging aid: echo the OTP in the API response (frontend shows a toast).
# NEVER enable in production.
# OTP_DEV_ECHO=true
# Throttling: codes are bound to the requesting browser. A browser can be sent
# one OTP per OTP_RESEND_SECONDS for a phone, browsers that have never logged in
# to that phone share OTP_MAX_SENDS_PER_HOUR codes an hour, and each code allows
# OTP_MAX_ATTEMPTS tries before it is dead (request a new one).
# OTP_RESEND_SECONDS=60
# OTP_MAX_SENDS_PER_HOUR=5
# OTP_MAX_ATTEMPTS=3

# Fast2SMS (https://www.fast2sms.com — Dev API > OTP route, personal KYC only)
# FAST2SMS_API_KEY=

# WhatsApp Cloud API (https://developers.facebook.com — see docs for setup)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_NAME=otp_verification
# WHATSAPP_TEMPLATE_LANGUAGE=en

# Email (Resend) — empty key disables outbound email
RESEND_API_KEY=
# EMAIL_FROM="Creative Matrimony <noreply@yourdomain.com>"  # after domain verification in Resend

# CORS — a bare URL, a comma-separated list, or a JSON array all work:
CORS_ORIGINS=http://localhost:3000
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# Chat moderation — extra blocked words/phrases (comma-separated), added to
# the built-in list. Whole-word match; a trailing * matches longer forms.
# MODERATION_BLOCKED_TERMS=idiot*,stupid fellow

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./uploads

# Debug
DEBUG=true
